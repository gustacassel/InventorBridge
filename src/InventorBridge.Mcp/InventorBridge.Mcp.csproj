<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InventorBridge.Mcp</RootNamespace>
  </PropertyGroup>

  <Import Project="..\..\InventorInterop.props" />

  <!-- The guides, read by the guide tool. Copied to bin\...\guides\. -->
  <ItemGroup>
    <None Include="..\..\docs\guides\*.md" Link="guides\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The generated API reference, read by api_lookup. Copied to bin\...\reference\. -->
  <ItemGroup>
    <None Include="..\..\docs\reference\members.tsv" Link="reference\members.tsv" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\docs\reference\objects\*.md" Link="reference\objects\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\docs\reference\enums\*.md" Link="reference\enums\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

</Project>
